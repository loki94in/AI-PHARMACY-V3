{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,x-admin-secret" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/catalog/(.*)", "destination": "/api/catalog.js?action=$1" },
    { "source": "/api/catalog", "destination": "/api/catalog.js" },
    { "source": "/shop", "destination": "/catalog.html" },
    { "source": "/catalog", "destination": "/catalog.html" },
    { "source": "/license", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/", "destination": "/catalog.html" }
  ]
}
